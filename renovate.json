{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":configMigration",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests"
  ],
  "timezone": "Europe/London",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["gomodTidy"],
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security"],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions annotated with '# renovate:' in the Makefile and workflows",
      "managerFilePatterns": ["/^Makefile$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s+[A-Z_]+\\s*(?:\\?=|:)\\s*\"?(?<currentValue>v?[^\\s\"]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Bump the go directive too (off by default)",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Go toolchain: go directive and golang base image move together",
      "groupName": "go toolchain",
      "matchDepNames": ["go", "golang"]
    },
    {
      "description": "Indirect Go modules are off by default; govulncheck flags them",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true,
      "groupName": "go indirect dependencies",
      "automerge": true
    },
    {
      "description": "Kubernetes stack moves as one. A controller-tools bump changes the CRDs; the verify job fails until 'make generate manifests' is committed. Bump ENVTEST_K8S_VERSION and SETUP_ENVTEST_VERSION in the Makefile by hand in the same PR",
      "groupName": "kubernetes",
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/controller-runtime", "sigs.k8s.io/controller-tools", "kubernetes-sigs/controller-tools"],
      "automerge": false
    },
    {
      "description": "Low risk: actions, base image digests, tool versions",
      "matchManagers": ["github-actions", "dockerfile", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Go module patches",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "digest"],
      "matchDepNames": ["!go"],
      "automerge": true
    },
    {
      "description": "One PR for all GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "golangci-lint minors add lints; review by hand",
      "matchDepNames": ["golangci/golangci-lint"],
      "automerge": false
    },
    {
      "description": "Go toolchain minors are reviewed by hand; patches (security fixes) merge on their own. Last, so it wins over the rules above",
      "matchDepNames": ["go", "golang"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    {
      "matchDepNames": ["go", "golang"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "automerge": true
    }
  ]
}
